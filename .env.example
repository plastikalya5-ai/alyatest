# Supabase (zorunlu)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # sadece sunucu tarafı; asla NEXT_PUBLIC_ yapma

# Hassas alan şifreleme (cari vergi_no) — 32 byte hex (64 karakter). Kaybedilirse şifreli veriler çözülemez.
FIELD_ENCRYPTION_KEY=

# E-posta bildirimleri (opsiyonel)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp bildirimleri — n8n webhook (opsiyonel)
N8N_WHATSAPP_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# OpenAI (opsiyonel) — tanımlı değilse tüm AI özellikleri sessizce kapalı kalır. Anahtarı asla NEXT_PUBLIC_ yapma.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini        # metin / görsel / araç çağrısı için kullanılacak model
# OPENAI_BASE_URL=https://api.openai.com/v1
